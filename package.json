{
  "name": "mbkauthe",
  "version": "6.0.0",
  "description": "MBKTech's reusable authentication system for Node.js applications.",
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx src/devServer.ts",
    "build": "tsc && node scripts/minify.js",
    "publish": "node scripts/publish.js",
    "create-tables": "node dist/db/schema/createTable.js",
    "test": "vitest run",
    "generate:diagrams": "node scripts/generate-diagrams.mjs",
    "install-mermaid": "npm i @mermaid-js/mermaid-cli@11.15.0 --save-dev"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./repositories": {
      "types": "./dist/db/repositories/index.d.ts",
      "default": "./dist/db/repositories/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./middleware": {
      "types": "./dist/http/middleware/index.d.ts",
      "default": "./dist/http/middleware/index.js"
    },
    "./utils": {
      "types": "./dist/http/response/index.d.ts",
      "default": "./dist/http/response/index.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "default": "./dist/services/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics/index.d.ts",
      "default": "./dist/diagnostics/index.js"
    },
    "./response": {
      "types": "./dist/http/response/index.d.ts",
      "default": "./dist/http/response/index.js"
    },
    "./oauth": {
      "types": "./dist/oauth/index.d.ts",
      "default": "./dist/oauth/index.js"
    },
    "./oauth/presets": {
      "types": "./dist/oauth/providers/index.d.ts",
      "default": "./dist/oauth/providers/index.js"
    },
    "./express": {
      "types": "./dist/express/index.d.ts",
      "default": "./dist/express/index.js"
    },
    "./package.json": "./package.json"

  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MIbnEKhalid/mbkauthe.git"
  },
  "keywords": [
    "login",
    "authentication",
    "nodejs",
    "express",
    "session",
    "security",
    "oauth",
    "2fa",
    "csrf"
  ],
  "author": "Muhammad Bin Khalid <support@mbktech.org> <chmuhammadbinkhalid28@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MIbnEKhalid/mbkauthe/issues"
  },
  "homepage": "https://github.com/MIbnEKhalid/mbkauthe#readme",
  "files": [
    "dist/",
    "docs/",
    "!docs/diagrams/**",
    "public/",
    "views/",
    ".env.example",
    "index.d.ts",
    "index.js",
    "index.ts",
    "LICENSE",
    "package.json",
    "README.md",
    "vercel.json"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "admindb": "^2.2.1",
    "better-sqlite3": "^11.9.1",
    "connect-pg-simple": "^10.0.0",
    "cookie": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "csurf": "^1.2.2",
    "debug": "^4.4.3",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-handlebars": "^9.0.1",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.1",
    "jose": "^6.2.12",
    "pg": "^8.16.3",
    "speakeasy": "^2.0.0"
  },
  "overrides": {
    "csurf": {
      "cookie": "^0.7.0"
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^7.2.1",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.14",
    "supertest": "^7.1.4",
    "terser": "^5.51.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
