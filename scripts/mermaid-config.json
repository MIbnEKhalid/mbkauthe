{
  "theme": "default",
  "themeVariables": {
    "fontFamily": "Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif",
    "fontSize": "15px"
  },
  "flowchart": {
    "padding": 24,
    "nodeSpacing": 45,
    "rankSpacing": 55,
    "useMaxWidth": false
  },
  "sequence": {
    "diagramMarginX": 40,
    "diagramMarginY": 30,
    "actorMargin": 60,
    "actorFontSize": 14,
    "actorFontFamily": "Segoe UI, -apple-system, sans-serif",
    "messageFontSize": 14,
    "messageFontFamily": "Segoe UI, -apple-system, sans-serif",
    "noteFontSize": 13,
    "useMaxWidth": false
  }
}
