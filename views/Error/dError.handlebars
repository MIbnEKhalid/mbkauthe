<!DOCTYPE html>
<html lang="en">

{{> head pageCode=code pageError=error ogUrl="/error"}}

<body>
  {{> header}}

  <section class="login-container">
    {{> backgroundElements}}

    <div class="glass-card error-page-box" role="region" aria-label="Error Notice">
      <div class="error-hero-icon {{#if (eq code 500)}}is-5xx{{else}}{{#if (eq code 404)}}is-4xx{{/if}}{{/if}}" aria-hidden="true">
        {{#if (eq code 404)}}
        <i class="fas fa-compass"></i>
        {{else if (eq code 500)}}
        <i class="fas fa-server"></i>
        {{else if (eq code 403)}}
        <i class="fas fa-user-lock"></i>
        {{else if (eq code 401)}}
        <i class="fas fa-key"></i>
        {{else}}
        <i class="fas fa-exclamation-triangle"></i>
        {{/if}}
      </div>

      <h1 class="status-code">{{code}}</h1>
      <h2 class="status-title">{{error}}</h2>

      <div class="status-content">
        <p class="status-message">{{message}}</p>
      </div>

      <div class="status-links">
        <a href="{{page}}" class="btn btn-primary">
          <i class="fas fa-arrow-left" aria-hidden="true"></i>
          <span>Return to {{#if pagename}}{{pagename}}{{else}}Home{{/if}}</span>
        </a>
        <a href="/mbkauthe/login" class="btn btn-outline">
          <i class="fas fa-sign-in-alt" aria-hidden="true"></i>
          <span>Login</span>
        </a>
        <a href="/mbkauthe/ErrorCode" class="btn btn-outline">
          <i class="fas fa-book" aria-hidden="true"></i>
          <span>Error Codes</span>
        </a>
      </div>

      {{#if details}}
      <div class="details-wrapper">
        <button class="details-toggle" type="button" aria-expanded="false" aria-controls="errorDetails">
          <span class="details-toggle-left">
            <i class="fas fa-terminal icon-primary" aria-hidden="true"></i>
            <span>Diagnostic & Trace</span>
            <span class="details-badge badge-success"><i class="fas fa-shield-alt" aria-hidden="true"></i> Redacted</span>
          </span>
          <i class="fas fa-chevron-down chev" aria-hidden="true"></i>
        </button>
        <div class="error-details-wrapper" id="errorDetails" hidden>
          <div class="details-security-notice" role="status">
            <i class="fas fa-shield-alt icon-primary" aria-hidden="true"></i>
            <span>Sensitive tokens, keys, and credentials are automatically scrubbed.</span>
          </div>

          <div class="details-terminal">
            <div class="details-terminal-toolbar">
              <span class="terminal-dots" aria-hidden="true">
                <span class="terminal-dot dot-red"></span>
                <span class="terminal-dot dot-yellow"></span>
                <span class="terminal-dot dot-green"></span>
                <span style="margin-left: 6px;">trace.log</span>
              </span>
              <div class="terminal-actions">
                <button class="terminal-btn btn-wrap-toggle" type="button" title="Toggle line wrap">
                  <i class="fas fa-align-left" aria-hidden="true"></i>
                  <span>Wrap</span>
                </button>
                <button class="terminal-btn btn-copy-trace" type="button" title="Copy trace">
                  <i class="fas fa-copy" aria-hidden="true"></i>
                  <span>Copy</span>
                </button>
              </div>
            </div>

            <div class="details-code-container">
              <pre class="details-code-block"><code class="details-code-text">{{details}}</code></pre>
              <span class="copy-feedback" aria-live="polite">Copied!</span>
            </div>
          </div>
        </div>
      </div>
      {{/if}}
    </div>
  </section>

  {{> versionInfo}}

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.details-wrapper').forEach((wrapper) => {
        const toggle = wrapper.querySelector('.details-toggle');
        const details = wrapper.querySelector('.error-details-wrapper');
        const icon = wrapper.querySelector('.chev');
        const copyBtn = wrapper.querySelector('.btn-copy-trace');
        const wrapBtn = wrapper.querySelector('.btn-wrap-toggle');
        const codeBlock = wrapper.querySelector('.details-code-block');
        const codeText = wrapper.querySelector('.details-code-text');
        const feedback = wrapper.querySelector('.copy-feedback');
        if (!toggle || !details) return;

        toggle.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = wrapper.classList.toggle('active');
          toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          details.hidden = !isOpen;
          if (icon) icon.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
        });

        if (wrapBtn && codeBlock) {
          wrapBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            codeBlock.classList.toggle('is-wrapped');
            wrapBtn.classList.toggle('active');
          });
        }

        if (copyBtn && codeText) {
          copyBtn.addEventListener('click', async (e) => {
            e.stopPropagation();
            try {
              await navigator.clipboard.writeText(codeText.textContent);
              if (feedback) {
                feedback.style.display = 'inline';
                setTimeout(() => { feedback.style.display = 'none'; }, 2000);
              }
            } catch (err) {
              console.error('[mbkauthe] Failed to copy error trace:', err);
            }
          });
        }
      });
    });
  </script>
</body>
</html>