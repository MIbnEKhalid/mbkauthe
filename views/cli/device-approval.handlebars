<!DOCTYPE html>
<html lang="en">

{{> head pageTitle="Approve CLI Login" ogUrl="/mbkauthe/cli/device"}}

<body>
    {{> header}}

    <style>
        .cli-device-box {
            max-width: 540px;
            padding: 2.5rem;
            text-align: center;
            animation: fadeInUp 0.4s ease-out;
        }

        .cli-device-icon {
            width: 72px;
            height: 72px;
            margin: 0 auto 1.25rem;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.7rem;
            color: #fff;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
        }

        .cli-device-icon.icon-pending {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        }

        .cli-device-icon.icon-success {
            background: linear-gradient(135deg, var(--success), var(--accent));
        }

        .cli-device-icon.icon-danger {
            background: linear-gradient(135deg, var(--danger), #c0392b);
        }

        .cli-device-icon.icon-muted {
            background: linear-gradient(135deg, #5a6578, #3d4656);
        }

        .cli-device-title {
            font-family: var(--font-display);
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0 0 0.5rem;
            color: var(--light);
            position: relative;
            display: inline-block;
        }

        .cli-device-title::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 60px;
            height: 3px;
            background-color: var(--accent);
            border-radius: 2px;
        }

        .cli-device-subtitle {
            color: var(--text-light);
            font-size: 0.95rem;
            margin: 1.25rem 0 1.5rem;
            line-height: 1.55;
        }

        .cli-client-name {
            font-weight: 700;
            color: var(--light);
        }

        .cli-user-code {
            font-family: var(--font-mono);
            font-size: 2rem;
            font-weight: 700;
            letter-spacing: 0.18em;
            background: var(--input-bg);
            border: 2px dashed color-mix(in srgb, var(--accent) 40%, transparent 60%);
            border-radius: 14px;
            padding: 0.85rem 1.25rem;
            margin: 0 auto 1.5rem;
            display: inline-block;
            color: var(--accent);
            user-select: all;
        }

        .cli-profile-box {
            text-align: left;
            background: color-mix(in srgb, var(--surface-1) 50%, transparent 50%);
            border: 1px solid color-mix(in srgb, var(--accent) 18%, transparent 82%);
            border-radius: 12px;
            padding: 1.25rem 1.5rem;
            margin-bottom: 1.5rem;
        }

        .cli-profile-box .row {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            padding: 0.4rem 0;
            font-size: 0.9rem;
            border-bottom: 1px solid color-mix(in srgb, var(--muted-border) 50%, transparent 50%);
        }

        .cli-profile-box .row:last-child {
            border-bottom: none;
        }

        .cli-profile-box .row .label {
            color: var(--text-light);
            flex-shrink: 0;
        }

        .cli-profile-box .row .value {
            color: var(--light);
            font-weight: 600;
            text-align: right;
            word-break: break-word;
        }

        .cli-scope-badge {
            display: inline-block;
            padding: 0.2rem 0.7rem;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .cli-scope-badge.read-only {
            background: color-mix(in srgb, var(--primary) 18%, transparent 82%);
            color: var(--primary);
        }

        .cli-scope-badge.write {
            background: color-mix(in srgb, var(--warning) 18%, transparent 82%);
            color: var(--warning);
        }

        .cli-app-chip {
            display: inline-block;
            font-family: var(--font-mono);
            font-size: 0.78rem;
            background: var(--input-bg);
            border: 1px solid var(--muted-border);
            padding: 0.15rem 0.55rem;
            border-radius: 6px;
            margin: 0.15rem 0.2rem 0 0;
            color: var(--text);
        }

        .cli-device-actions {
            display: flex;
            gap: 0.85rem;
            justify-content: center;
            margin-top: 0.25rem;
        }

        .cli-device-actions .btn-deny {
            flex: 1;
            padding: 0.75rem 1rem;
            border-radius: var(--border-radius);
            font-size: 0.95rem;
            font-weight: 700;
            cursor: pointer;
            background: transparent;
            color: var(--danger);
            border: 2px solid color-mix(in srgb, var(--danger) 45%, transparent 55%);
            transition: var(--transition);
        }

        .cli-device-actions .btn-deny:hover {
            background: color-mix(in srgb, var(--danger) 12%, transparent 88%);
            border-color: var(--danger);
            box-shadow: 0 4px 18px rgba(255, 118, 117, 0.2);
        }

        .cli-device-actions .btn-approve {
            flex: 1;
            padding: 0.75rem 1rem;
            border-radius: var(--border-radius);
            font-size: 0.95rem;
            font-weight: 700;
            cursor: pointer;
            background: var(--accent);
            color: var(--dark);
            border: 2px solid var(--accent);
            transition: var(--transition);
            box-shadow: 0 4px 18px rgba(0, 184, 148, 0.25);
        }

        .cli-device-actions .btn-approve:hover {
            background: transparent;
            color: var(--accent);
            box-shadow: 0 6px 24px rgba(0, 184, 148, 0.35);
        }

        .cli-device-actions button:disabled {
            opacity: 0.55;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        .cli-device-message {
            margin-top: 1.25rem;
            font-size: 0.88rem;
            color: var(--text-light);
            line-height: 1.5;
        }

        .cli-device-spinner {
            display: inline-block;
            width: 18px;
            height: 18px;
            border: 3px solid rgba(0, 184, 148, 0.25);
            border-top-color: var(--accent);
            border-radius: 50%;
            animation: cli-spin 0.7s linear infinite;
            vertical-align: middle;
            margin-right: 0.4rem;
        }

        @keyframes cli-spin {
            to {
                transform: rotate(360deg);
            }
        }

        .cli-status-card {
            padding: 1.25rem 0 0.5rem;
        }

        .cli-status-card .cli-device-icon {
            margin-bottom: 1.5rem;
        }
    </style>

    {{> showmessage}}

    <section class="login-container">

        {{> backgroundElements}}

        <div class="login-box cli-device-box">

            {{#if (eq status 'notfound')}}
                <div class="cli-status-card">
                    <div class="cli-device-icon icon-danger"><i class="fas fa-exclamation-triangle"></i></div>
                    <h1 class="cli-device-title">Request Not Found</h1>
                    <p class="cli-device-subtitle">{{#if error}}{{error}}{{else}}This login request could not be found or has already been processed.{{/if}}</p>
                    <p class="cli-device-message">Please start the CLI login again to get a fresh verification code.</p>
                </div>

            {{else if (eq status 'pending')}}
                <div class="cli-device-icon icon-pending"><i class="fas fa-terminal"></i></div>
                <h1 class="cli-device-title">Approve CLI Login</h1>
                <p class="cli-device-subtitle">
                    <span class="cli-client-name">{{clientName}}</span> is requesting an API token for CLI access.
                </p>

                <div class="cli-user-code">{{userCode}}</div>

                {{#if profile}}
                <div class="cli-profile-box">
                    <div class="row">
                        <span class="label">Token profile</span>
                        <span class="value">{{profile.name}}</span>
                    </div>
                    <div class="row">
                        <span class="label">Permission scope</span>
                        <span class="value">
                            <span class="cli-scope-badge {{#if (eq profile.scope 'write')}}write{{else}}read-only{{/if}}">
                                {{profile.scope}}
                            </span>
                        </span>
                    </div>
                    <div class="row">
                        <span class="label">Allowed applications</span>
                        <span class="value">
                            {{#if profile.allowedApps}}
                                {{#each profile.allowedApps}}<span class="cli-app-chip">{{this}}</span>{{/each}}
                            {{else}}
                                Any
                            {{/if}}
                        </span>
                    </div>
                    <div class="row">
                        <span class="label">Expiration</span>
                        <span class="value">{{#if profile.expiresInDays}}{{profile.expiresInDays}} day(s){{else}}Never{{/if}}</span>
                    </div>
                    <div class="row">
                        <span class="label">Requested by</span>
                        <span class="value">{{username}}</span>
                    </div>
                </div>
                {{/if}}

                <div class="cli-device-actions">
                    <button class="btn-deny" id="btnDeny" onclick="submitApproval('deny')"><i class="fas fa-times"></i> Deny</button>
                    <button class="btn-approve" id="btnApprove" onclick="submitApproval('approve')"><i class="fas fa-check"></i> Approve</button>
                </div>
                <p class="cli-device-message">
                    {{#if expiresInSeconds}}This request expires in <strong>{{expiresInSeconds}} seconds</strong>.{{else}}This request is about to expire.{{/if}}
                </p>

            {{else if (eq status 'approved')}}
                <div class="cli-status-card">
                    <div class="cli-device-icon icon-success"><i class="fas fa-check"></i></div>
                    <h1 class="cli-device-title">Login Approved</h1>
                    <p class="cli-device-subtitle">The CLI has been authorized successfully. Return to your terminal — it will receive the token momentarily.</p>
                </div>

            {{else if (eq status 'completed')}}
                <div class="cli-status-card">
                    <div class="cli-device-icon icon-success"><i class="fas fa-check-circle"></i></div>
                    <h1 class="cli-device-title">Token Delivered</h1>
                    <p class="cli-device-subtitle">The API token has been securely handed to the CLI. You can close this page now.</p>
                </div>

            {{else if (eq status 'denied')}}
                <div class="cli-status-card">
                    <div class="cli-device-icon icon-danger"><i class="fas fa-ban"></i></div>
                    <h1 class="cli-device-title">Login Denied</h1>
                    <p class="cli-device-subtitle">You denied this CLI login request. The CLI will not receive a token.</p>
                </div>

            {{else if (eq status 'expired')}}
                <div class="cli-status-card">
                    <div class="cli-device-icon icon-muted"><i class="fas fa-hourglass-end"></i></div>
                    <h1 class="cli-device-title">Request Expired</h1>
                    <p class="cli-device-subtitle">This login request expired before it was approved. Please start the CLI login process again.</p>
                </div>

            {{else}}
                <div class="cli-status-card">
                    <div class="cli-device-icon icon-muted"><i class="fas fa-circle-info"></i></div>
                    <h1 class="cli-device-title">Unknown Request</h1>
                    <p class="cli-device-subtitle">The status of this request could not be determined. Please start the CLI login again.</p>
                </div>
            {{/if}}

        </div>
    </section>

    {{> versionInfo}}

    <script>
        const userCode = {{#if userCode}}"{{userCode}}"{{else}}null{{/if}};

        window.submitApproval = async function (action) {
            const approveBtn = document.getElementById('btnApprove');
            const denyBtn = document.getElementById('btnDeny');
            if (approveBtn) { approveBtn.disabled = true; approveBtn.innerHTML = '<span class="cli-device-spinner"></span>Processing...'; }
            if (denyBtn) { denyBtn.disabled = true; }

            try {
                const res = await fetch('/api/cli/device/approve', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userCode, action }),
                });
                const data = await res.json();

                if (res.ok && data.success) {
                    window.location.reload();
                    return;
                }
                showMessage(data.message || 'Failed to process your request. Please try again.', 'Approval Failed');
            } catch (err) {
                console.error(err);
                showMessage('Failed to process your request. Please try again.', 'Approval Failed');
            } finally {
                if (approveBtn) { approveBtn.disabled = false; approveBtn.innerHTML = '<i class="fas fa-check"></i> Approve'; }
                if (denyBtn) { denyBtn.disabled = false; }
            }
        };
    </script>
</body>

</html>
