<!DOCTYPE html>
<html lang="en">

{{> head pageTitle="Two-Factor Authentication" ogUrl="/mbkauthe/2fa"}}

<body>
    {{> header}}

    {{> showmessage}}
    {{> passkeyPromptModal}}

    <section class="login-container">
        {{> backgroundElements}}

        <div class="auth-card login-box login-box-single">
            <div class="auth-card-header">
                <div class="auth-icon-badge" aria-hidden="true">
                    <i class="fas fa-shield-halved"></i>
                </div>
                <h1 class="login-title">Two-Factor Authentication</h1>
                <p class="login-subtitle">Enter the 6-digit verification code from your authenticator app</p>
            </div>

            <form id="loginForm" method="POST" class="otp-form" novalidate>
                <input type="hidden" name="_csrf" value="{{csrfToken}}">
                <input type="hidden" id="token" name="token" value="">

                <!-- 6-Box Segmented OTP Input Grid -->
                <div class="otp-container" id="otpGroup" role="group" aria-label="Two-factor authentication code">
                    <input type="text" class="otp-digit" inputmode="numeric" pattern="[0-9]*" maxlength="1" data-index="0" autofocus aria-label="Digit 1" autocomplete="one-time-code" />
                    <input type="text" class="otp-digit" inputmode="numeric" pattern="[0-9]*" maxlength="1" data-index="1" aria-label="Digit 2" />
                    <input type="text" class="otp-digit" inputmode="numeric" pattern="[0-9]*" maxlength="1" data-index="2" aria-label="Digit 3" />
                    <span class="otp-separator" aria-hidden="true">&ndash;</span>
                    <input type="text" class="otp-digit" inputmode="numeric" pattern="[0-9]*" maxlength="1" data-index="3" aria-label="Digit 4" />
                    <input type="text" class="otp-digit" inputmode="numeric" pattern="[0-9]*" maxlength="1" data-index="4" aria-label="Digit 5" />
                    <input type="text" class="otp-digit" inputmode="numeric" pattern="[0-9]*" maxlength="1" data-index="5" aria-label="Digit 6" />
                </div>

                <button type="submit" class="btn-primary btn-submit" id="loginButton">
                    <span id="loginButtonText">Verify & Continue</span>
                </button>

                <div class="form-footer-links">
                    <a href="/mbkauthe/login" class="auth-link-back">
                        <i class="fas fa-arrow-left"></i>
                        <span>Back to Login</span>
                    </a>
                </div>

                <p class="terms-info">
                    Having trouble? <a href="#" onclick="tokeninfo(); return false;">What is 2FA?</a> or contact
                    <a href="https://mbktech.org/Support" target="_blank" rel="noopener noreferrer">Support</a>.
                </p>
            </form>
        </div>
    </section>

    {{> versionInfo}}

    <script>
        const tokeninfo = () => showMessage('The 2FA token is a 6-digit code generated by your authenticator app (such as Google Authenticator, Microsoft Authenticator, or Authy). Enter the code shown in your app to complete login.', 'What is 2FA?');

        // Segmented OTP Handler
        const otpDigits = Array.from(document.querySelectorAll('.otp-digit'));
        const hiddenTokenInput = document.getElementById('token');

        function updateHiddenToken() {
            const val = otpDigits.map(d => d.value).join('');
            if (hiddenTokenInput) hiddenTokenInput.value = val;
            return val;
        }

        otpDigits.forEach((digit, idx) => {
            digit.addEventListener('input', (e) => {
                const val = e.target.value.replace(/\D/g, '');
                digit.value = val.slice(-1);
                updateHiddenToken();

                if (digit.value && idx < otpDigits.length - 1) {
                    otpDigits[idx + 1].focus();
                    otpDigits[idx + 1].select();
                }

                if (idx === otpDigits.length - 1 && digit.value) {
                    const fullCode = updateHiddenToken();
                    if (fullCode.length === 6) {
                        document.getElementById('loginForm')?.requestSubmit();
                    }
                }
            });

            digit.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && !digit.value && idx > 0) {
                    otpDigits[idx - 1].focus();
                    otpDigits[idx - 1].value = '';
                    updateHiddenToken();
                } else if (e.key === 'ArrowLeft' && idx > 0) {
                    otpDigits[idx - 1].focus();
                } else if (e.key === 'ArrowRight' && idx < otpDigits.length - 1) {
                    otpDigits[idx + 1].focus();
                }
            });

            digit.addEventListener('paste', (e) => {
                e.preventDefault();
                const pastedData = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '').slice(0, 6);
                if (!pastedData) return;

                pastedData.split('').forEach((char, i) => {
                    if (otpDigits[i]) otpDigits[i].value = char;
                });

                const code = updateHiddenToken();
                const focusIdx = Math.min(pastedData.length, otpDigits.length - 1);
                otpDigits[focusIdx].focus();

                if (code.length === 6) {
                    document.getElementById('loginForm')?.requestSubmit();
                }
            });
        });

        document.getElementById('loginForm')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const token = updateHiddenToken();
            const csrfToken = document.querySelector('input[name="_csrf"]')?.value;
            const loginButton = document.getElementById('loginButton');
            const loginButtonText = document.getElementById('loginButtonText');

            if (!token || token.length !== 6) {
                return showMessage('Please enter all 6 digits of your verification code.', 'Incomplete Code');
            }

            loginButton.disabled = true;
            loginButtonText.textContent = 'Verifying...';

            try {
                const response = await fetch('/mbkauthe/api/verify-2fa', {
                    method: 'POST',
                    credentials: 'include',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ token, _csrf: csrfToken })
                });
                const data = await response.json();
                if (data.success) {
                    loginButtonText.textContent = 'Success!';
                    promptPasskeyOrRedirect(data.username || '', data.redirect_url || '{{ customURL }}');
                } else {
                    loginButton.disabled = false;
                    loginButtonText.textContent = 'Verify & Continue';
                    showMessage(data.message || 'Verification failed. Please check your code and try again.', 'Verification Failed');
                    otpDigits.forEach(d => d.value = '');
                    updateHiddenToken();
                    otpDigits[0]?.focus();
                }
            } catch {
                loginButton.disabled = false;
                loginButtonText.textContent = 'Verify & Continue';
                showMessage('Failed to verify token. Please check your connection and try again.', 'Error');
            }
        });
    </script>
</body>
</html>