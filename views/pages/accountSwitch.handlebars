<!DOCTYPE html>
<html lang="en">

{{> head pageTitle="Switch Account" ogUrl="/mbkauthe/accounts"}}

<body>
    {{> header}}
    {{> showmessage}}

    <section class="login-container account-switch">
        {{> backgroundElements}}

        <div class="auth-card login-box login-box-split">
            <div class="login-box-inner">
                <!-- Left Sidebar -->
                <div class="login-sidebar">
                    <div class="sidebar-content">
                        <div class="brand-section">
                            <div class="logo logo-sidebar">
                                <img src="/icon.svg" alt="MBK Tech Logo" class="logo-image">
                                <span class="logo-text">BK<span>Tech</span></span>
                            </div>
                            <h2 class="brand-title">Account Switcher</h2>
                            <p class="brand-description">Quickly navigate between multiple active user sessions on this browser.</p>
                        </div>

                        <div class="sidebar-actions">
                            <a href="/mbkauthe/login" id="useAnother" class="btn-action-link full-width">
                                <i class="fas fa-user-plus"></i>
                                <span>Add another account</span>
                            </a>
                        </div>

                        <div class="sidebar-links">
                            <a href="https://portal.mbktech.org/forgot-password" class="sidebar-link">
                                <i class="fas fa-key"></i> Forgot Password?
                            </a>
                            <a href="https://mbktech.org/Support" target="_blank" class="sidebar-link">
                                <i class="fas fa-headset"></i> Need Help?
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Right Main Panel -->
                <div class="login-main">
                    <div class="login-main-header">
                        <h1 class="login-title">Choose an Account</h1>
                        <p class="login-subtitle">Continue to <span class="app-pill">{{appName}}</span></p>
                    </div>

                    <div id="accountList" class="account-list" aria-live="polite">
                        <div class="loading-state">
                            <div class="spinner"></div>
                            <p>Loading accounts...</p>
                        </div>
                    </div>

                    <div id="emptyState" class="empty-state hidden-by-default">
                        <div class="empty-state-icon"><i class="fas fa-users-slash"></i></div>
                        <h3>No Active Sessions</h3>
                        <p>No signed-in accounts were found on this browser.</p>
                        <a href="/mbkauthe/login" class="btn-primary btn-submit">Sign In to an Account</a>
                    </div>

                    <div class="switch-footer-actions">
                        <button class="btn-outline btn-logout-all" id="logoutAll" type="button">
                            <i class="fas fa-sign-out-alt"></i>
                            <span>Sign out of all accounts</span>
                        </button>
                    </div>

                    <div class="mobile-switch-links">
                        <a href="/mbkauthe/login" class="btn-action-link mobile-switch-btn full-width">
                            <i class="fas fa-user-plus"></i>
                            <span>Add another account</span>
                        </a>
                        <button class="btn-outline mobile-logout-btn full-width" type="button">
                            <i class="fas fa-sign-out-alt"></i>
                            <span>Sign out of all accounts</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script>
        function sanitizeRelativeRedirect(value) {
            if (typeof value !== 'string') return null;
            const trimmed = value.trim();
            if (trimmed.startsWith('/') && !trimmed.startsWith('//') && !trimmed.includes('://') && !trimmed.includes('\\')) {
                return trimmed;
            }
            try {
                const parsed = new URL(trimmed, window.location.origin);
                if (parsed.origin === window.location.origin) {
                    return parsed.pathname + parsed.search + parsed.hash;
                }
            } catch {}
            return null;
        }

        const redirectTarget = sanitizeRelativeRedirect(new URLSearchParams(window.location.search).get('redirect')) || '{{customURL}}';

        (() => {
            const loginUrl = `/mbkauthe/login${redirectTarget ? `?redirect=${encodeURIComponent(redirectTarget)}` : ''}`;
            ['useAnother', '.mobile-switch-btn', '#emptyState a.btn-login-inline'].forEach((sel) => {
                const el = sel.startsWith('.') || sel.startsWith('#') ? document.querySelector(sel) : document.getElementById(sel);
                if (el) el.href = loginUrl;
            });
        })();

        const handleUseAnother = (e) => {
            e.preventDefault();
            window.location.href = `/mbkauthe/login?redirect=${encodeURIComponent(redirectTarget)}`;
        };
        document.getElementById('useAnother')?.addEventListener('click', handleUseAnother);
        document.querySelector('.mobile-switch-btn')?.addEventListener('click', handleUseAnother);

        async function loadAccounts() {
            const list = document.getElementById('accountList');
            const empty = document.getElementById('emptyState');
            if (!list || !empty) return;

            try {
                const res = await fetch('/mbkauthe/api/account-sessions', { credentials: 'include' });
                const data = await res.json();
                const accounts = Array.isArray(data.accounts) ? data.accounts : [];
                const currentId = data.current_session_id || data.currentSessionId || null;

                list.innerHTML = '';
                if (!accounts.length) {
                    empty.style.display = 'block';
                    return;
                }
                empty.style.display = 'none';

                accounts.slice(0, 5).forEach((acct) => {
                    const sid = acct.session_id;
                    const fullName = acct.full_name || acct.username || '?';
                    const isCurrent = acct.is_current !== undefined ? acct.is_current : (currentId && sid === currentId);
                    const initial = fullName.charAt(0).toUpperCase();
                    const role = (acct.role || 'user').toLowerCase();

                    const item = document.createElement('div');
                    item.className = `account-item ${isCurrent ? 'is-current' : ''}`;
                    item.role = 'button';
                    item.tabIndex = 0;
                    item.setAttribute('aria-label', `Account ${fullName}, ${acct.username}${isCurrent ? ' (Current)' : ''}`);

                    // Avatar
                    const avatar = document.createElement('div');
                    avatar.className = 'avatar';

                    const initials = document.createElement('div');
                    initials.className = 'initials';
                    initials.textContent = initial;
                    initials.style.display = acct.image ? 'none' : 'flex';

                    if (acct.image) {
                        const img = document.createElement('img');
                        img.className = 'avatar-img';
                        img.src = acct.image;
                        img.alt = `Avatar for ${acct.username}`;
                        img.loading = 'lazy';
                        img.onerror = () => { img.style.display = 'none'; initials.style.display = 'flex'; };
                        avatar.appendChild(img);
                    }
                    avatar.appendChild(initials);

                    // Info Container
                    const info = document.createElement('div');
                    info.className = 'account-info';

                    // Header Row
                    const headerRow = document.createElement('div');
                    headerRow.className = 'account-header-row';

                    const nameEl = document.createElement('div');
                    nameEl.className = 'account-name';
                    nameEl.textContent = fullName;
                    headerRow.appendChild(nameEl);

                    // Badges inside header/info
                    const badges = document.createElement('div');
                    badges.className = 'account-badges';

                    if (role === 'superadmin' || role === 'admin') {
                        const roleBadge = document.createElement('span');
                        roleBadge.className = `role-badge badge-${role}`;
                        roleBadge.textContent = role === 'superadmin' ? 'Superadmin' : 'Admin';
                        badges.appendChild(roleBadge);
                    }

                    if (isCurrent) {
                        const badge = document.createElement('div');
                        badge.className = 'current-badge';
                        badge.textContent = 'Active';
                        badges.appendChild(badge);
                    }
                    headerRow.appendChild(badges);

                    // Meta Row
                    const metaRow = document.createElement('div');
                    metaRow.className = 'account-meta-row';

                    const emailEl = document.createElement('div');
                    emailEl.className = 'account-email';
                    emailEl.textContent = acct.username;
                    metaRow.appendChild(emailEl);

                    info.appendChild(headerRow);
                    info.appendChild(metaRow);

                    // Actions Container (Single account removal)
                    const actions = document.createElement('div');
                    actions.className = 'account-actions';

                    const removeBtn = document.createElement('button');
                    removeBtn.className = 'btn-remove-account';
                    removeBtn.type = 'button';
                    removeBtn.title = `Sign out ${acct.username}`;
                    removeBtn.setAttribute('aria-label', `Sign out ${acct.username}`);
                    removeBtn.innerHTML = '<i class="fas fa-sign-out-alt"></i>';

                    removeBtn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        removeSingleAccount(sid, acct.username);
                    });

                    actions.appendChild(removeBtn);

                    item.appendChild(avatar);
                    item.appendChild(info);
                    item.appendChild(actions);

                    const onSelect = () => {
                        if (!isCurrent) switchSession(sid);
                    };

                    item.addEventListener('click', onSelect);
                    item.addEventListener('keydown', (e) => {
                        if (e.key === 'Enter' || e.key === ' ') {
                            e.preventDefault();
                            onSelect();
                        }
                    });

                    list.appendChild(item);
                });
            } catch (err) {
                console.error('[mbkauthe] Failed to load accounts:', err);
                list.innerHTML = '<div class="empty-state">Failed to load accounts.</div>';
            }
        }

        async function removeSingleAccount(sessionId, username) {
            if (!confirm(`Are you sure you want to sign out ${username || 'this account'} on this device?`)) return;

            try {
                const res = await fetch('/mbkauthe/api/logout-account', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ session_id: sessionId })
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    if (data.is_current_logged_out) {
                        showMessage('Current account signed out. Reloading...', 'Account Sign out');
                    }
                    loadAccounts();
                } else {
                    showMessage(data.message || 'Could not sign out account', 'Account Sign out');
                }
            } catch {
                showMessage('Could not sign out account right now. Please try again.', 'Account Sign out');
            }
        }

        async function switchSession(sessionId) {
            try {
                const res = await fetch('/mbkauthe/api/switch-session', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ session_id: sessionId, redirect: redirectTarget })
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    const params = new URLSearchParams(window.location.search);
                    const queryRedirect = sanitizeRelativeRedirect(params.get('redirect'));
                    window.location.href = data.redirect || queryRedirect || redirectTarget;
                } else {
                    showMessage(data.message || 'Could not switch account', 'Switch Account');
                    loadAccounts();
                }
            } catch {
                showMessage('Could not switch account right now. Please try again.', 'Switch Account');
            }
        }

        async function logoutAll() {
            if (!confirm('Are you sure you want to sign out of all accounts on this device?')) return;
            try {
                const res = await fetch('/mbkauthe/api/logout-all', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include'
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    window.location.href = `/mbkauthe/login?redirect=${encodeURIComponent(redirectTarget)}`;
                } else {
                    showMessage(data.message || 'Could not sign out all accounts', 'Sign out');
                }
            } catch {
                showMessage('Could not sign out all accounts right now. Please try again.', 'Sign out');
            }
        }

        document.getElementById('logoutAll')?.addEventListener('click', logoutAll);
        document.querySelector('.mobile-logout-btn')?.addEventListener('click', logoutAll);
        document.addEventListener('DOMContentLoaded', loadAccounts);
    </script>
</body>
</html>