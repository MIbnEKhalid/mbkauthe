<!DOCTYPE html>
<html lang="en">

{{> mbkutils_head pageTitle="Change Password" ogUrl="/mbkauthe/change-password"}}

<body>
    {{> mbkutils_header}}
    {{> mbkutils_showmessage}}

    <section class="login-container">
        {{> mbkutils_backgroundElements}}

        <div class="auth-card login-box login-box-split">
            <div class="login-box-inner">
                <!-- Left Sidebar: Security Context & Account Meta -->
                <div class="login-sidebar">
                    <div class="sidebar-content">
                        <div class="brand-section">
                            <div class="logo logo-sidebar">
                                <img src="/icon.svg{{acachebust}}" alt="MBK Tech Logo" class="logo-image">
                                <span class="logo-text">BK<span>Authe</span></span>
                            </div>
                            <div class="badge-role-row" style="margin: 12px 0;">
                                <span class="badge" style="background: rgba(0, 184, 148, 0.15); color: #00b894; border: 1px solid rgba(0, 184, 148, 0.3); padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600;">
                                    <i class="fas fa-shield-halved"></i> Security Verification
                                </span>
                            </div>
                            <h2 class="brand-title">Password Update</h2>
                            <p class="brand-description">
                                A password change is required for your account before you can continue accessing connected workspaces.
                            </p>
                        </div>

                        {{#if username}}
                        <div class="current-user-card" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 8px; padding: 12px 14px; margin: 16px 0; display: flex; align-items: center; gap: 10px;">
                            <div class="user-avatar-badge" style="font-size: 20px; color: #00b894;">
                                <i class="fas fa-user-check"></i>
                            </div>
                            <div class="user-meta" style="line-height: 1.2;">
                                <span class="user-meta-label" style="font-size: 11px; opacity: 0.6; display: block;">Signed In As</span>
                                <strong class="user-meta-name">@{{username}}</strong>
                            </div>
                        </div>
                        {{/if}}

                        <div class="sidebar-links" style="margin-top: auto;">
                            <a href="/mbkauthe/accounts" class="sidebar-link">
                                <i class="fas fa-users"></i> Switch Account
                            </a>
                            <a href="https://mbktech.org/Support" target="_blank" rel="noopener noreferrer" class="sidebar-link">
                                <i class="fas fa-headset"></i> Need Help?
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Right Main: Password Form -->
                <div class="login-main">
                    <div class="login-main-header">
                        <h1 class="login-title">Set New Password</h1>
                        <p class="login-subtitle">Choose a strong, unique password to secure your account across all services.</p>
                    </div>

                    <form id="changePasswordForm" class="login-form auth-form" autocomplete="off">
                        <!-- New Password -->
                        <div class="form-group floating-group">
                            <input id="newPassword" class="form-input" type="password" name="newPassword" placeholder=" "
                                minlength="8" autocomplete="new-password" required />
                            <label class="form-label" for="newPassword">New Password (min 8 chars)</label>
                            <button type="button" class="icon-button input-icon toggle-password-btn" data-target="newPassword" aria-label="Toggle password visibility">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>

                        <!-- Confirm Password -->
                        <div class="form-group floating-group">
                            <input id="confirmPassword" class="form-input" type="password" name="confirmPassword" placeholder=" "
                                minlength="8" autocomplete="new-password" required />
                            <label class="form-label" for="confirmPassword">Confirm New Password</label>
                            <button type="button" class="icon-button input-icon toggle-password-btn" data-target="confirmPassword" aria-label="Toggle password visibility">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>

                        <div id="formErrorMessage" style="display: none; color: #ff7675; background: rgba(255, 118, 117, 0.1); border: 1px solid rgba(255, 118, 117, 0.2); padding: 10px; border-radius: 6px; font-size: 13px;"></div>

                        <button type="submit" class="btn-primary btn-submit" id="submitBtn">
                            <i class="fas fa-check-circle" id="submitBtnIcon"></i>
                            <span id="submitBtnText">Update Password &amp; Continue</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Password Toggles
            document.querySelectorAll('.toggle-password-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const targetId = btn.getAttribute('data-target');
                    const input = document.getElementById(targetId);
                    if (!input) return;
                    const isPass = input.type === 'password';
                    input.type = isPass ? 'text' : 'password';
                    btn.querySelector('i').classList.toggle('fa-eye', !isPass);
                    btn.querySelector('i').classList.toggle('fa-eye-slash', isPass);
                });
            });

            const form = document.getElementById('changePasswordForm');
            const newPasswordInput = document.getElementById('newPassword');
            const confirmPasswordInput = document.getElementById('confirmPassword');
            const submitBtn = document.getElementById('submitBtn');
            const submitBtnText = document.getElementById('submitBtnText');
            const submitBtnIcon = document.getElementById('submitBtnIcon');
            const errBox = document.getElementById('formErrorMessage');

            const showError = (msg) => {
                if (errBox) {
                    errBox.textContent = msg;
                    errBox.style.display = 'block';
                } else if (typeof showMessage === 'function') {
                    showMessage(msg, 'Error');
                } else {
                    alert(msg);
                }
            };

            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                errBox.style.display = 'none';

                const newPassword = newPasswordInput.value;
                const confirmPassword = confirmPasswordInput.value;

                if (!newPassword || newPassword.length < 8) {
                    return showError('Password must be at least 8 characters long.');
                }
                if (newPassword !== confirmPassword) {
                    return showError('Passwords do not match.');
                }

                submitBtn.disabled = true;
                submitBtnText.textContent = 'Updating...';

                try {
                    const res = await fetch('/mbkauthe/api/change-password', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ newPassword, confirmPassword })
                    });
                    const data = await res.json();

                    if (!res.ok || !data.success) {
                        submitBtn.disabled = false;
                        submitBtnText.textContent = 'Update Password & Continue';
                        return showError(data.error || data.message || 'Failed to change password.');
                    }

                    submitBtnText.textContent = 'Success! Redirecting...';
                    if (submitBtnIcon) submitBtnIcon.className = 'fas fa-check-double';

                    const urlParams = new URLSearchParams(window.location.search);
                    const target = urlParams.get('redirect') || data.redirect_url || '/dashboard';
                    setTimeout(() => {
                        window.location.href = target;
                    }, 800);
                } catch (err) {
                    submitBtn.disabled = false;
                    submitBtnText.textContent = 'Update Password & Continue';
                    showError(err.message || 'Network error occurred.');
                }
            });
        });
    </script>
</body>
</html>

