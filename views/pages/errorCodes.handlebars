<!DOCTYPE html>
<html lang="en">

{{> head pageTitle="Error Codes Reference" ogUrl="/mbkauthe/ErrorCode"}}

<body>
    {{> header}}

    <div class="container">
        <div class="page-header-doc">
            <h1>🔐 MBKAuthe Error Codes</h1>
            <p>Complete reference guide for all error codes and their solutions</p>
        </div>

        <div class="search-box-sticky">
            <input type="text" class="search-input-doc form-input" id="searchInput" placeholder="Search by error code, name, or description...">
        </div>

        <div id="errorContainer">
            {{#each errorCategories}}
            <div class="category" data-category="{{this.category}}">
                <div class="category-header">
                    <h2>{{this.icon}} {{this.name}}</h2>
                    <span class="range">{{this.range}}</span>
                </div>

                {{#each this.errors}}
                <div class="error-card" id="error-{{this.code}}" data-search="{{this.code}} {{this.name}} {{this.message}} {{this.userMessage}} {{this.hint}}">
                    <div class="error-header">
                        <span class="error-code">{{this.code}}</span>
                        <span class="error-name">{{this.name}}</span>
                    </div>
                    <div class="error-message">{{this.userMessage}}</div>
                    <div class="error-hint">💡 {{this.hint}}</div>
                </div>
                {{/each}}
            </div>
            {{/each}}
        </div>

        <div class="no-results hidden-by-default" id="noResults">
            No error codes found matching your search.
        </div>
    </div>

    <div class="back-to-top" id="backToTop" aria-label="Back to top">↑</div>

    <script>
        const searchInput = document.getElementById('searchInput');
        const errorCards = document.querySelectorAll('.error-card');
        const categories = document.querySelectorAll('.category');
        const noResults = document.getElementById('noResults');

        searchInput?.addEventListener('input', function () {
            const term = this.value.toLowerCase().trim();
            let hasResults = !term;

            errorCards.forEach((card) => {
                const match = !term || (card.getAttribute('data-search') || '').toLowerCase().includes(term);
                card.classList.toggle('is-hidden', !match);
                if (match) hasResults = true;
            });

            categories.forEach((cat) => {
                const hasVisible = !term || Boolean(cat.querySelector('.error-card:not(.is-hidden)'));
                cat.classList.toggle('is-hidden', !hasVisible);
            });

            noResults?.classList.toggle('hidden-by-default', hasResults);
        });

        const backToTop = document.getElementById('backToTop');
        window.addEventListener('scroll', () => backToTop?.classList.toggle('visible', window.pageYOffset > 300));
        backToTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

        function scrollToError() {
            if (!window.location.hash) return;
            const rawId = window.location.hash.substring(1);
            const targetId = (!rawId.startsWith('error-') && /^\d+$/.test(rawId)) ? `error-${rawId}` : rawId;
            const targetEl = document.getElementById(targetId);

            if (targetEl) {
                setTimeout(() => {
                    targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    targetEl.style.borderColor = 'var(--primary)';
                    targetEl.style.boxShadow = '0 0 0 3px rgba(15, 118, 110, 0.3)';
                    setTimeout(() => {
                        targetEl.style.borderColor = '';
                        targetEl.style.boxShadow = '';
                    }, 2500);
                }, 100);
            }
        }

        scrollToError();
        window.addEventListener('hashchange', scrollToError);
    </script>
</body>
</html>