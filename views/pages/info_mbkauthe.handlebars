<!DOCTYPE html>
<html lang="en">

{{> head pageTitle="System Information" ogUrl="/mbkauthe/info"}}

<body>
    {{> header appName=mbkautheVar.APP_NAME}}

    <section class="login-container">
        {{> backgroundElements}}

        <div class="glass-card info-box">
            <div class="info-header">
                <div class="info-icon-badge icon-primary" aria-hidden="true">
                    <i class="fas fa-server"></i>
                </div>
                <div>
                    <h1 class="info-title">System Information</h1>
                    <p class="info-subtitle">Application runtime parameters, environment configuration, and version status.</p>
                </div>
            </div>

            <!-- Quick Metrics Grid -->
            <div class="info-stats-grid">
                <div class="info-stat-card">
                    <div class="info-stat-icon icon-primary" aria-hidden="true"><i class="fas fa-code-branch"></i></div>
                    <div class="info-stat-content">
                        <span class="info-stat-label">mbkauthe Core</span>
                        <div class="info-stat-value">v<span id="CurrentVersion">{{CurrentVersion}}</span></div>
                        <div class="info-stat-badge-row">
                            {{#if latestVersion}}
                                {{#if (eq latestVersion CurrentVersion)}}
                                <span class="version-status badge-success"><i class="fas fa-check-circle"></i> Up to date</span>
                                {{else}}
                                <span class="version-status badge-danger"><i class="fas fa-arrow-alt-circle-up"></i> Latest: v{{latestVersion}}</span>
                                {{/if}}
                            {{else}}
                                <span class="version-status"><i class="fas fa-info-circle"></i> v{{CurrentVersion}}</span>
                            {{/if}}
                        </div>
                    </div>
                </div>

                <div class="info-stat-card">
                    <div class="info-stat-icon icon-primary" aria-hidden="true"><i class="fas fa-cubes"></i></div>
                    <div class="info-stat-content">
                        <span class="info-stat-label">Host Application</span>
                        <div class="info-stat-value">{{mbkautheVar.APP_NAME}}</div>
                        <span class="info-stat-sub">Release: <code>v{{APP_VERSION}}</code></span>
                    </div>
                </div>

                <div class="info-stat-card">
                    <div class="info-stat-icon icon-primary" aria-hidden="true"><i class="fas fa-cloud"></i></div>
                    <div class="info-stat-content">
                        <span class="info-stat-label">Environment</span>
                        <div class="info-stat-value">
                            {{#if (eq mbkautheVar.IS_DEPLOYED "true")}}
                            <span class="status-pill badge-success"><i class="fas fa-circle"></i> Production</span>
                            {{else}}
                            <span class="status-pill badge-warning"><i class="fas fa-circle"></i> Development</span>
                            {{/if}}
                        </div>
                        <span class="info-stat-sub">{{#if (eq mbkautheVar.IS_DEPLOYED "true")}}IS_DEPLOYED: true{{else}}Local Sandbox / Dev{{/if}}</span>
                    </div>
                </div>
            </div>

            <!-- Configuration Parameters -->
            <div class="info-section">
                <div class="info-section-header">
                    <h2><i class="fas fa-sliders-h"></i> Configuration Parameters</h2>
                    <span class="info-badge-count">Runtime Config</span>
                </div>
                
                <div class="info-table">
                    <div class="info-row">
                        <div class="info-label"><i class="fas fa-tag"></i> APP_NAME</div>
                        <div class="info-value"><code>{{mbkautheVar.APP_NAME}}</code></div>
                    </div>
                    <div class="info-row">
                        <div class="info-label"><i class="fas fa-code-commit"></i> APP_VERSION</div>
                        <div class="info-value"><code>{{APP_VERSION}}</code></div>
                    </div>
                    <div class="info-row">
                        <div class="info-label"><i class="fas fa-globe"></i> DOMAIN</div>
                        <div class="info-value"><code>{{mbkautheVar.DOMAIN}}</code></div>
                    </div>
                    <div class="info-row">
                        <div class="info-label"><i class="fas fa-shield-alt"></i> IS_DEPLOYED</div>
                        <div class="info-value">
                            {{#if (eq mbkautheVar.IS_DEPLOYED "true")}}
                            <span class="badge badge-success">true</span>
                            {{else}}
                            <span class="badge">{{mbkautheVar.IS_DEPLOYED}}</span>
                            {{/if}}
                        </div>
                    </div>
                    <div class="info-row">
                        <div class="info-label"><i class="fas fa-location-arrow"></i> Login Redirect URL</div>
                        <div class="info-value"><code>{{mbkautheVar.login_redirect_url}}</code></div>
                    </div>
                    {{#if authorized}}
                    <div class="info-row">
                        <div class="info-label"><i class="fas fa-mobile-alt"></i> Two-Factor Auth</div>
                        <div class="info-value"><code>{{mbkautheVar.MBKAUTH_TWO_FA_ENABLE}}</code></div>
                    </div>
                    <div class="info-row">
                        <div class="info-label"><i class="fas fa-cookie-bite"></i> Cookie Expiration</div>
                        <div class="info-value"><code>{{mbkautheVar.COOKIE_EXPIRE_TIME}} Days</code></div>
                    </div>
                    {{/if}}
                </div>
            </div>

            <!-- Navigation Links -->
            <div class="info-actions">
                <a class="btn btn-outline" href="/mbkauthe/login"><i class="fas fa-sign-in-alt"></i> Login</a>
                <a class="btn btn-outline" href="/mbkauthe/test"><i class="fas fa-user-check"></i> Session Test</a>
                <a class="btn btn-outline" href="/mbkauthe/ErrorCode"><i class="fas fa-book"></i> Error Codes</a>
                <a class="btn btn-outline" href="https://github.com/MIbnEKhalid/mbkauthe" target="_blank" rel="noopener noreferrer"><i class="fab fa-github"></i> GitHub</a>
            </div>
        </div>
    </section>

    {{> versionInfo}}
</body>
</html>