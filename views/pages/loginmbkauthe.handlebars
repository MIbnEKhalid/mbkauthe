<!DOCTYPE html>
<html lang="en">

{{> head pageTitle="Login" ogUrl="/mbkauthe/login"}}

<body>
    {{> header}}

    {{> showmessage}}
    {{> passkeyPromptModal}}

    <section class="login-container">
        {{> backgroundElements}}

        <div class="auth-card login-box login-box-split">
            <div class="login-box-inner">
                <!-- Left Sidebar: Brand & OAuth -->
                <div class="login-sidebar">
                    <div class="sidebar-content">
                        <div class="brand-section">
                            <div class="logo logo-sidebar">
                                <img src="/icon.svg" alt="MBK Tech Logo" class="logo-image">
                                <span class="logo-text">BK<span>Authe</span></span>
                            </div>
                            <h2 class="brand-title">Welcome to MBKAuthe</h2>
                            <p class="brand-description">Enterprise single sign-on & secure access across MBKTech services.</p>
                        </div>

                        {{#if hasOAuthProviders}}
                        <div class="sidebar-actions">
                            <span class="sidebar-section-title">Sign in with provider</span>
                            <div class="oauth-providers-list">
                                {{#each enabledOAuthProviders}}
                                <button type="button" id="{{id}}LoginBtn" data-provider="{{id}}" data-url="{{loginUrl}}" class="btn-oauth {{btnClass}} last-used-parent oauth-login-btn">
                                    <i class="{{iconClass}} oauth-icon"></i>
                                    <span class="oauth-name">{{displayName}}</span>
                                    {{#if isLastUsed}}<span class="last-used-badge" aria-hidden="true" title="Last used">Last</span>{{/if}}
                                </button>
                                {{/each}}
                            </div>
                        </div>
                        {{/if}}

                        <div class="sidebar-switch">
                            <a href="/mbkauthe/accounts" id="switchacc" class="btn-action-link">
                                <i class="fas fa-users"></i>
                                <span>Switch Account</span>
                            </a>
                        </div>

                        <div class="sidebar-links">
                            <a href="https://portal.mbktech.org/forgot-password" class="sidebar-link" rel="noopener noreferrer">
                                <i class="fas fa-key"></i> Forgot Password?
                            </a>
                            <a href="https://mbktech.org/Support" target="_blank" rel="noopener noreferrer" class="sidebar-link">
                                <i class="fas fa-headset"></i> Help & Support
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Right Panel: Password Form -->
                <div class="login-main">
                    <div class="login-main-header">
                        <h1 class="login-title">Sign In</h1>
                        <p class="login-subtitle">Enter your credentials to access your account</p>
                    </div>

                    {{#if showLoggedOutMessage}}
                    <div class="alert-banner alert-warning" role="alert">
                        <div class="alert-icon"><i class="fas fa-shield-alt"></i></div>
                        <div class="alert-body">
                            <strong class="alert-heading">Authentication Required</strong>
                            <p class="alert-text">You have been redirected because your session expired or is required.</p>
                            {{#if redirectTarget}}
                            <div class="alert-meta"><code>{{redirectTarget}}</code></div>
                            {{/if}}
                        </div>
                    </div>
                    {{/if}}

                    <form id="loginForm" method="POST" class="login-form" novalidate>
                        <input type="hidden" name="_csrf" value="{{csrfToken}}">
                        
                        <div class="form-group floating-group">
                            <input id="loginUsername" class="form-input" type="text" name="username" placeholder=" "
                                required pattern="^[a-z0-9.]+$" autocomplete="username"
                                title="Username must contain lowercase letters, numbers, and periods only."
                                oninput="this.value = this.value.toLowerCase().replace(/[^a-z0-9.]/g, '')" />
                            <label class="form-label" for="loginUsername">Username</label>
                            <button type="button" class="icon-button input-icon" onclick="usernameinfo()" aria-label="What is my username?">
                                <i class="fas fa-circle-question"></i>
                            </button>
                        </div>

                        <div class="form-group floating-group">
                            <input id="loginPassword" class="form-input" type="password" name="Password" placeholder=" "
                                required minlength="8" autocomplete="current-password"
                                title="Password must be at least 8 characters long" />
                            <label class="form-label" for="loginPassword">Password</label>
                            <button type="button" class="icon-button input-icon" id="togglePassword" aria-label="Show password">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>

                        <div class="form-row-split">
                            <label class="checkbox-label" for="rememberMe">
                                <input type="checkbox" id="rememberMe" name="rememberMe" class="custom-checkbox">
                                <span class="checkbox-box"></span>
                                <span class="checkbox-text">Remember me</span>
                            </label>
                            <a href="https://portal.mbktech.org/forgot-password" class="auth-link">Forgot password?</a>
                        </div>

                        <button type="submit" class="btn-primary btn-submit last-used-parent" id="loginButton">
                            <span id="loginButtonText">Sign In</span>
                            {{#if lastLoginPassword}}<span class="last-used-badge" aria-hidden="true" title="Last used">Last</span>{{/if}}
                        </button>

                        <button type="button" class="btn-passkey" id="passkeySignInBtn">
                            <i class="fas fa-fingerprint" aria-hidden="true"></i>
                            <span>Sign in with Passkey</span>
                        </button>

                        {{#if userLoggedIn}}
                        <div class="alert-banner alert-info already-logged-info">
                            <div class="alert-icon"><i class="fas fa-user-check"></i></div>
                            <div class="alert-body">
                                Signed in as <strong class="username"><span id="headerProfileUserName">{{username}}</span></strong>.
                                <div class="alert-actions">
                                    <a class="link-primary" href="{{customURL}}">Dashboard</a> &bull; 
                                    <a class="link-primary" href="/mbkauthe/accounts">Switch Account</a>
                                </div>
                            </div>
                        </div>
                        {{/if}}

                        <div class="mobile-oauth-section">
                            {{#if hasOAuthProviders}}
                            <div class="auth-divider"><span>or continue with</span></div>
                            <div class="mobile-oauth-grid">
                                {{#each enabledOAuthProviders}}
                                <button type="button" class="btn-oauth-icon oauth-login-btn last-used-parent" data-provider="{{id}}" data-url="{{loginUrl}}" title="{{displayName}}" aria-label="{{displayName}}">
                                    <i class="{{iconClass}}"></i>
                                    {{#if isLastUsed}}<span class="last-used-badge" aria-hidden="true" title="Last used">Last</span>{{/if}}
                                </button>
                                {{/each}}
                            </div>
                            {{/if}}

                            <div class="mobile-switch-row">
                                <a href="/mbkauthe/accounts" class="btn-action-link full-width">
                                    <i class="fas fa-users"></i>
                                    <span>Switch Account</span>
                                </a>
                            </div>
                        </div>

                        <p class="terms-info">
                            Protected by MBKAuthe enterprise security. By signing in, you agree to our
                            <a href="https://mbktech.org/Terms&Conditions" target="_blank" rel="noopener noreferrer">Terms</a> &amp; 
                            <a href="https://mbktech.org/PrivacyPolicy" target="_blank" rel="noopener noreferrer">Privacy</a>.
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </section>

    {{> versionInfo}}

    <script>
        const cookieDomain = '{{cookieDomain}}';

        function sanitizeRelativeRedirect(value) {
            if (typeof value !== 'string') return null;
            const trimmed = value.trim();
            if (trimmed.startsWith('/') && !trimmed.startsWith('//') && !trimmed.includes('://') && !trimmed.includes('\\')) {
                return trimmed;
            }
            try {
                const parsed = new URL(trimmed, window.location.origin);
                if (parsed.origin === window.location.origin) {
                    return parsed.pathname + parsed.search + parsed.hash;
                }
            } catch {}
            return null;
        }

        const togglePassword = document.getElementById('togglePassword');
        const passwordInput = document.getElementById('loginPassword');
        if (togglePassword && passwordInput) {
            togglePassword.addEventListener('click', () => {
                const isPass = passwordInput.type === 'password';
                passwordInput.type = isPass ? 'text' : 'password';
                togglePassword.setAttribute('aria-label', isPass ? 'Hide password' : 'Show password');
                togglePassword.querySelector('i')?.classList.toggle('fa-eye', !isPass);
                togglePassword.querySelector('i')?.classList.toggle('fa-eye-slash', isPass);
            });
        }

        function fpass() {
            showMessage('If you have forgotten your password, please contact support at <a href="https://mbktech.org/Support" target="_blank" rel="noopener noreferrer">https://mbktech.org/Support</a> to reset it.', 'Forgot Password');
        }

        function usernameinfo() {
            showMessage('Your username is the part of your MBKTech.org email before the @ (e.g., abc.xyz@mbktech.org → abc.xyz). For guests or if you’ve forgotten your credentials, contact <a href="https://mbktech.org/Support" rel="noopener noreferrer">Support</a>.', 'What is my username?');
        }

        function tokeninfo() {
            showMessage('The 2FA token is a 6-digit code generated by your authenticator app (such as Google Authenticator, Microsoft Authenticator, or Authy). Enter the code shown in your app to complete login. If you have not set up 2FA or are having trouble, please contact support.', 'What is the 2FA token?');
        }

        document.getElementById('loginForm')?.addEventListener('submit', async (event) => {
            event.preventDefault();
            const username = document.getElementById('loginUsername')?.value.trim();
            const password = document.getElementById('loginPassword')?.value.trim();
            const loginButton = document.getElementById('loginButton');
            const loginButtonText = document.getElementById('loginButtonText');
            const rememberMe = document.getElementById('rememberMe')?.checked;

            if (!username || !password) return showMessage('Username and password are required', 'Login Error');
            if (password.length < 8) return showMessage('Password must be at least 8 characters long', 'Login Error');

            loginButton.disabled = true;
            loginButtonText.textContent = 'Authenticating...';

            const urlParams = new URLSearchParams(window.location.search);
            const pageRedirect = sanitizeRelativeRedirect(urlParams.get('redirect'));

            try {
                const response = await fetch('/mbkauthe/api/login', {
                    method: 'POST',
                    credentials: 'include',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, password, redirect: pageRedirect || null })
                });
                const data = await response.json();

                if (data.success) {
                    const is2fa = Boolean(data.two_factor_required);
                    const redirect = data.redirect_url || pageRedirect;
                    if (is2fa) {
                        window.location.href = `/mbkauthe/2fa${redirect ? `?redirect=${encodeURIComponent(redirect)}` : ''}`;
                    } else {
                        loginButtonText.textContent = 'Success!';
                        if (rememberMe) setCookie('rememberedUsername', username, 30);
                        else deleteCookie('rememberedUsername');
                        promptPasskeyOrRedirect(username, redirect || '{{customURL}}');
                    }
                } else {
                    loginButton.disabled = false;
                    loginButtonText.textContent = 'Login';
                    showMessage(data.message || 'Login failed. Please try again.', 'Login Error', data.error_code);
                }
            } catch (error) {
                loginButton.disabled = false;
                loginButtonText.textContent = 'Login';
                console.error('[mbkauthe] Error:', error);
                showMessage('An error occurred. Please try again.', 'Login Error');
            }
        });

        function setCookie(name, value, days) {
            const expires = days ? `; expires=${new Date(Date.now() + days * 864e5).toUTCString()}` : '';
            const domain = cookieDomain ? `; domain=${cookieDomain}` : '';
            document.cookie = `${name}=${value || ''}${expires}; path=/; SameSite=Lax${domain}`;
        }

        function getCookie(name) {
            return document.cookie.split('; ').find((row) => row.startsWith(`${name}=`))?.split('=')[1] ?? null;
        }

        function deleteCookie(name) {
            const domain = cookieDomain ? `; domain=${cookieDomain}` : '';
            document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/${domain}`;
        }

        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const usernameInput = document.getElementById('loginUsername');

            if (urlParams.has('password')) {
                urlParams.delete('password');
                const sanitizedQuery = urlParams.toString();
                window.history.replaceState({}, document.title, `${window.location.pathname}${sanitizedQuery ? `?${sanitizedQuery}` : ''}${window.location.hash}`);
                showMessage('Passwords must not be passed in the URL. Enter your password in the form instead.', 'Security Notice');
            }

            const rememberedUsername = getCookie('rememberedUsername');
            if (rememberedUsername && usernameInput) {
                usernameInput.value = rememberedUsername;
                const rem = document.getElementById('rememberMe');
                if (rem) rem.checked = true;
            }

            if (!usernameInput?.value) usernameInput?.focus();
            else document.getElementById('loginPassword')?.focus();
        });

        function bufferToBase64URL(buffer) {
            const bytes = new Uint8Array(buffer);
            let binary = '';
            for (let i = 0; i < bytes.byteLength; i++) {
                binary += String.fromCharCode(bytes[i]);
            }
            return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
        }

        function base64URLToBuffer(base64url) {
            const base64 = base64url.replace(/-/g, '+').replace(/_/g, '/');
            const padLen = (4 - (base64.length % 4)) % 4;
            const padded = base64 + '='.repeat(padLen);
            const binary = atob(padded);
            const bytes = new Uint8Array(binary.length);
            for (let i = 0; i < binary.length; i++) {
                bytes[i] = binary.charCodeAt(i);
            }
            return bytes.buffer;
        }

        async function handlePasskeyLogin(targetUsername) {
            if (!window.PublicKeyCredential) {
                showMessage('Passkeys are not supported by this browser.', 'Not Supported');
                return;
            }
            const passkeyBtn = document.getElementById('passkeySignInBtn');
            if (passkeyBtn) passkeyBtn.disabled = true;

            try {
                const optRes = await fetch('/mbkauthe/api/passkey/login-options', {
                    method: 'POST',
                    credentials: 'include',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username: targetUsername || undefined })
                });
                const optData = await optRes.json();
                if (!optData.success || !optData.options) {
                    throw new Error(optData.message || 'Failed to get passkey options');
                }

                const options = optData.options;
                options.challenge = base64URLToBuffer(options.challenge);
                if (options.allowCredentials) {
                    options.allowCredentials = options.allowCredentials.map(cred => ({
                        ...cred,
                        id: base64URLToBuffer(cred.id)
                    }));
                }

                const credential = await navigator.credentials.get({
                    publicKey: options
                });

                if (!credential) throw new Error('No credential returned');

                const credentialJSON = {
                    id: credential.id,
                    rawId: bufferToBase64URL(credential.rawId),
                    response: {
                        authenticatorData: bufferToBase64URL(credential.response.authenticatorData),
                        clientDataJSON: bufferToBase64URL(credential.response.clientDataJSON),
                        signature: bufferToBase64URL(credential.response.signature),
                        userHandle: credential.response.userHandle ? bufferToBase64URL(credential.response.userHandle) : null
                    },
                    type: credential.type,
                    clientExtensionResults: credential.getClientExtensionResults ? credential.getClientExtensionResults() : {}
                };

                const urlParams = new URLSearchParams(window.location.search);
                const pageRedirect = sanitizeRelativeRedirect(urlParams.get('redirect'));

                const verifyRes = await fetch('/mbkauthe/api/passkey/login-verify', {
                    method: 'POST',
                    credentials: 'include',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        response: credentialJSON,
                        redirect: pageRedirect || null
                    })
                });

                const verifyData = await verifyRes.json();
                if (verifyData.success) {
                    window.location.href = verifyData.redirect_url || '{{customURL}}';
                } else {
                    showMessage(verifyData.message || 'Passkey verification failed', 'Login Failed');
                    if (passkeyBtn) passkeyBtn.disabled = false;
                }
            } catch (err) {
                if (passkeyBtn) passkeyBtn.disabled = false;
                if (err.name === 'NotAllowedError') {
                    return;
                }
                console.error('[Passkey Error]', err);
                showMessage(err.message || 'Passkey login failed', 'Passkey Error');
            }
        }

        document.getElementById('passkeySignInBtn')?.addEventListener('click', () => {
            const usernameInput = document.getElementById('loginUsername');
            const targetUsername = usernameInput?.value?.trim() || undefined;
            handlePasskeyLogin(targetUsername);
        });

        document.querySelectorAll('.oauth-login-btn').forEach((btn) => {
            btn.addEventListener('click', () => {
                const url = btn.getAttribute('data-url');
                if (!url) return;
                const redirect = new URLSearchParams(window.location.search).get('redirect') || '{{customURL}}';
                window.location.href = `${url}?redirect=${encodeURIComponent(redirect)}`;
            });
        });
    </script>
</body>
</html>