<!DOCTYPE html>
<html lang="en">

{{> head pageTitle="Login" ogUrl="/mbkauthe/login"}}

<body>
    {{> header}}

    {{> showmessage}}

    <section class="login-container">
        {{> backgroundElements}}

        <div class="glass-card login-box login-box-split">
            <div class="login-box-inner">
                <div class="login-sidebar">
                    <div class="sidebar-content">
                        <div class="brand-section">
                            <div class="logo logo-centered">
                                <img src="/icon.svg" alt="Logo" class="logo-image">
                                <span class="logo-text">BK <span>Tech</span></span>
                            </div>
                            <h2 class="brand-title">Welcome to MBKAuthe</h2>
                            <p class="brand-description">Secure authentication for MBKTech.org services</p>
                        </div>

                        <div class="sidebar-actions">
                            {{#if githubLoginEnabled }}
                            <button type="button" id="githubLoginBtn" class="btn-social btn-switch-side last-used-parent">
                                <i class="fab fa-github"></i>
                                <span>Login with GitHub</span>
                                {{#if lastLoginGithub}}<span class="last-used-badge" aria-hidden="true" title="Last used">Last</span>{{/if}}
                            </button>
                            {{/if}}
                            {{#if googleLoginEnabled }}
                            <button type="button" id="googleLoginBtn" class="btn-social btn-google-side last-used-parent">
                                <i class="fab fa-google"></i>
                                <span>Login with Google</span>
                                {{#if lastLoginGoogle}}<span class="last-used-badge" aria-hidden="true" title="Last used">Last</span>{{/if}}
                            </button>
                            {{/if}}
                            <a href="/mbkauthe/accounts" id="switchacc" class="btn-social btn-switch-side">
                                <i class="fa fa-user-group"></i>
                                <span>Switch Account</span>
                            </a>
                        </div>

                        <div class="sidebar-links">
                            <a href="https://portal.mbktech.org/forgot-password" class="sidebar-link" rel="noopener noreferrer">
                                <i class="fas fa-key"></i> Forgot Password?
                            </a>
                            <a href="https://mbktech.org/Support" target="_blank" rel="noopener noreferrer" class="sidebar-link">
                                <i class="fas fa-life-ring"></i> Need Help?
                            </a>
                        </div>
                    </div>
                </div>

                <div class="login-main">
                    <h1 class="login-title title-underline">Login</h1>

                    {{#if showLoggedOutMessage}}
                    <div class="WarningboxInfo" style="margin-bottom: 20px; border-left-color: #ff3b30;">
                        <strong class="warning-title">Authentication Required</strong>
                        <div>You have been redirected here because you are not logged in or your session has expired. Please log in to continue.</div>
                        {{#if redirectTarget}}
                        <div style="margin-top: 10px; font-size: 0.9em; opacity: 0.9;">
                            <strong>Attempted URL:</strong> <code>{{redirectTarget}}</code>
                        </div>
                        {{/if}}
                    </div>
                    {{/if}}

                    <form id="loginForm" method="POST" class="login-form">
                        <input type="hidden" name="_csrf" value="{{csrfToken}}">
                        <div class="form-group">
                            <input id="loginUsername" class="form-input" type="text" name="username" placeholder=" "
                                required pattern="^[a-z0-9.]+$"
                                title="Username must contain lowercase letters, numbers, and periods only, no spaces, no special characters."
                                oninput="this.value = this.value.toLowerCase().replace(/[^a-z0-9.]/g, '')" />
                            <label class="form-label">Username</label>
                            <button type="button" class="icon-button input-icon" onclick="usernameinfo()" aria-label="What is my username?">
                                <i class="fas fa-info-circle"></i>
                            </button>
                        </div>

                        <div class="form-group">
                            <input id="loginPassword" class="form-input" type="password" name="Password" placeholder=""
                                required minlength="8" title="Password must be at least 8 characters long" />
                            <label class="form-label">Password</label>
                            <button type="button" class="icon-button input-icon" id="togglePassword" aria-label="Show password">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>

                        <div class="form-row-split">
                            <div class="remember-me remember-me-inline">
                                <input type="checkbox" id="rememberMe" name="rememberMe" class="custom-checkbox">
                                <label for="rememberMe">Remember me</label>
                            </div>
                            <a href="https://portal.mbktech.org/forgot-password" class="login-link login-link-nowrap">Forgot Password?</a>
                        </div>

                        <button type="submit" class="btn-login last-used-parent" id="loginButton">
                            <span id="loginButtonText">Login</span>
                            {{#if lastLoginPassword}}<span class="last-used-badge" aria-hidden="true" title="Last used">Last</span>{{/if}}
                        </button>

                        {{#if userLoggedIn }}
                        <div class="WarningboxInfo already-logged-info">
                            You are already logged in as <strong class="username"><span id="headerProfileUserName">{{username}}</span></strong>. <a class="link-primary" href="{{customURL}}">Go to dashboard</a> or <a class="link-primary" href="/mbkauthe/accounts">switch account</a>.
                        </div>
                        {{/if}}

                        <div class="mobile-actions">
                            {{#if githubLoginEnabled }}
                            {{#if googleLoginEnabled }}
                            <div class="social-login">
                                <div class="divider"><span>or</span></div>
                                <div class="social-icons-row">
                                    <button type="button" class="swi s mobile-github-btn last-used-parent" title="Login with GitHub" aria-label="Login with GitHub">
                                        <i class="fab fa-github"></i>
                                        {{#if lastLoginGithub}}<span class="last-used-badge" aria-hidden="true" title="Last used">Last</span>{{/if}}
                                    </button>
                                    <button type="button" class="swi s mobile-google-btn last-used-parent" title="Login with Google" aria-label="Login with Google">
                                        <i class="fab fa-google"></i>
                                        {{#if lastLoginGoogle}}<span class="last-used-badge" aria-hidden="true" title="Last used">Last</span>{{/if}}
                                    </button>
                                </div>
                            </div>
                            <div class="divider"><span>or</span></div>
                            {{/if}}
                            {{/if}}

                            <a href="/mbkauthe/accounts" class="swi btn-social btn-switch-side">
                                <i class="fa fa-user-group"></i>
                                <span>Switch Account</span>
                            </a>
                        </div>

                        <p class="terms-info">
                            By logging in, you agree to our
                            <a href="https://mbktech.org/Terms&Conditions" target="_blank" rel="noopener noreferrer" class="link-primary">Terms & Conditions</a>
                            and
                            <a href="https://mbktech.org/PrivacyPolicy" target="_blank" rel="noopener noreferrer" class="link-primary">Privacy Policy</a>.
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </section>

    {{> versionInfo}}

    <script>
        const cookieDomain = '{{cookieDomain}}';

        function sanitizeRelativeRedirect(value) {
            if (typeof value !== 'string') return null;
            const trimmed = value.trim();
            if (trimmed.startsWith('/') && !trimmed.startsWith('//') && !trimmed.includes('://') && !trimmed.includes('\\')) {
                return trimmed;
            }
            try {
                const parsed = new URL(trimmed, window.location.origin);
                if (parsed.origin === window.location.origin) {
                    return parsed.pathname + parsed.search + parsed.hash;
                }
            } catch {}
            return null;
        }

        const togglePassword = document.getElementById('togglePassword');
        const passwordInput = document.getElementById('loginPassword');
        if (togglePassword && passwordInput) {
            togglePassword.addEventListener('click', () => {
                const isPass = passwordInput.type === 'password';
                passwordInput.type = isPass ? 'text' : 'password';
                togglePassword.setAttribute('aria-label', isPass ? 'Hide password' : 'Show password');
                togglePassword.querySelector('i')?.classList.toggle('fa-eye', !isPass);
                togglePassword.querySelector('i')?.classList.toggle('fa-eye-slash', isPass);
            });
        }

        function fpass() {
            showMessage('If you have forgotten your password, please contact support at <a href="https://mbktech.org/Support" target="_blank" rel="noopener noreferrer">https://mbktech.org/Support</a> to reset it.', 'Forgot Password');
        }

        function usernameinfo() {
            showMessage('Your username is the part of your MBKTech.org email before the @ (e.g., abc.xyz@mbktech.org → abc.xyz). For guests or if you’ve forgotten your credentials, contact <a href="https://mbktech.org/Support" rel="noopener noreferrer">Support</a>.', 'What is my username?');
        }

        function tokeninfo() {
            showMessage('The 2FA token is a 6-digit code generated by your authenticator app (such as Google Authenticator, Microsoft Authenticator, or Authy). Enter the code shown in your app to complete login. If you have not set up 2FA or are having trouble, please contact support.', 'What is the 2FA token?');
        }

        document.getElementById('loginForm')?.addEventListener('submit', async (event) => {
            event.preventDefault();
            const username = document.getElementById('loginUsername')?.value.trim();
            const password = document.getElementById('loginPassword')?.value.trim();
            const loginButton = document.getElementById('loginButton');
            const loginButtonText = document.getElementById('loginButtonText');
            const rememberMe = document.getElementById('rememberMe')?.checked;

            if (!username || !password) return showMessage('Username and password are required', 'Login Error');
            if (password.length < 8) return showMessage('Password must be at least 8 characters long', 'Login Error');

            loginButton.disabled = true;
            loginButtonText.textContent = 'Authenticating...';

            const urlParams = new URLSearchParams(window.location.search);
            const pageRedirect = sanitizeRelativeRedirect(urlParams.get('redirect'));

            try {
                const response = await fetch('/mbkauthe/api/login', {
                    method: 'POST',
                    credentials: 'include',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, password, redirect: pageRedirect || null })
                });
                const data = await response.json();

                if (data.success) {
                    const is2fa = Boolean(data.two_factor_required);
                    const redirect = data.redirect_url || pageRedirect;
                    if (is2fa) {
                        window.location.href = `/mbkauthe/2fa${redirect ? `?redirect=${encodeURIComponent(redirect)}` : ''}`;
                    } else {
                        loginButtonText.textContent = 'Success! Redirecting...';
                        if (rememberMe) setCookie('rememberedUsername', username, 30);
                        else deleteCookie('rememberedUsername');
                        window.location.href = redirect || '{{customURL}}';
                    }
                } else {
                    loginButton.disabled = false;
                    loginButtonText.textContent = 'Login';
                    showMessage(data.message || 'Login failed. Please try again.', 'Login Error', data.error_code);
                }
            } catch (error) {
                loginButton.disabled = false;
                loginButtonText.textContent = 'Login';
                console.error('[mbkauthe] Error:', error);
                showMessage('An error occurred. Please try again.', 'Login Error');
            }
        });

        function setCookie(name, value, days) {
            const expires = days ? `; expires=${new Date(Date.now() + days * 864e5).toUTCString()}` : '';
            const domain = cookieDomain ? `; domain=${cookieDomain}` : '';
            document.cookie = `${name}=${value || ''}${expires}; path=/; SameSite=Lax${domain}`;
        }

        function getCookie(name) {
            return document.cookie.split('; ').find((row) => row.startsWith(`${name}=`))?.split('=')[1] ?? null;
        }

        function deleteCookie(name) {
            const domain = cookieDomain ? `; domain=${cookieDomain}` : '';
            document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/${domain}`;
        }

        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const usernameInput = document.getElementById('loginUsername');

            if (urlParams.has('password')) {
                urlParams.delete('password');
                const sanitizedQuery = urlParams.toString();
                window.history.replaceState({}, document.title, `${window.location.pathname}${sanitizedQuery ? `?${sanitizedQuery}` : ''}${window.location.hash}`);
                showMessage('Passwords must not be passed in the URL. Enter your password in the form instead.', 'Security Notice');
            }

            const rememberedUsername = getCookie('rememberedUsername');
            if (rememberedUsername && usernameInput) {
                usernameInput.value = rememberedUsername;
                const rem = document.getElementById('rememberMe');
                if (rem) rem.checked = true;
            }

            if (!usernameInput?.value) usernameInput?.focus();
            else document.getElementById('loginPassword')?.focus();
        });

        {{#if githubLoginEnabled }}
        const startGithubLogin = () => {
            const redirect = new URLSearchParams(window.location.search).get('redirect') || '{{customURL}}';
            window.location.href = `/mbkauthe/api/github/login?redirect=${encodeURIComponent(redirect)}`;
        };
        document.getElementById('githubLoginBtn')?.addEventListener('click', startGithubLogin);
        document.querySelector('.mobile-github-btn')?.addEventListener('click', startGithubLogin);
        {{/if}}

        {{#if googleLoginEnabled }}
        const startGoogleLogin = () => {
            const redirect = new URLSearchParams(window.location.search).get('redirect') || '{{customURL}}';
            window.location.href = `/mbkauthe/api/google/login?redirect=${encodeURIComponent(redirect)}`;
        };
        document.getElementById('googleLoginBtn')?.addEventListener('click', startGoogleLogin);
        document.querySelector('.mobile-google-btn')?.addEventListener('click', startGoogleLogin);
        {{/if}}
    </script>
</body>
</html>