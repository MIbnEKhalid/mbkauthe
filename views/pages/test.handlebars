<!DOCTYPE html>
<html lang="en">

{{> head pageTitle="Session Test" ogUrl="/mbkauthe/test"}}

<body>
    {{> header}}
    <section class="login-container">
        {{> backgroundElements}}

        <div class="glass-card session-card" role="region" aria-label="User Session">
            <div class="avatar-large" aria-hidden="true">
                <img src="/mbkauthe/user/profilepic?u={{profile_pic_url}}"
                    alt="Avatar for {{username}}" title="{{display_name}}" loading="lazy" decoding="async" width="96" height="96"
                    class="avatar-img"
                    onerror="this.style.display='none';this.nextElementSibling&&(this.nextElementSibling.style.display='flex');" />
                <div class="avatar-initials" aria-hidden="true">{{initial}}</div>
            </div>

            <div class="session-meta">
                <div>
                    <div class="session-status">✅ Authentication successful</div>
                    <h3 class="session-title">{{username}} <span class="session-role">· {{role}}</span></h3>
                    <p class="session-sub">UserId: {{user_id}} · Session: {{session_id_short}}…</p>
                </div>

                <div class="session-details" aria-live="polite">
                    <div><span class="text-highlight">Full Name:</span> {{full_name}}</div>
                    <div><span class="text-highlight">Allowed Apps:</span> {{allowed_apps}}</div>
                    <div><span class="text-highlight">Session Expires:</span> <span id="session-expiry-display">{{#if session_expiry}}{{session_expiry}}{{else}}N/A{{/if}}</span></div>
                    {{#if session_expiry}}<div id="session-countdown"><span class="text-highlight">Time Remaining:</span> <span id="countdown-value">calculating…</span></div>{{/if}}
                </div>

                <div class="session-actions">
                    <button class="btn btn-danger" onclick="mbkauthe.logout()" aria-label="Log out" type="button">
                        <i class="fas fa-sign-out-alt"></i> Logout
                    </button>
                    <a class="btn btn-outline" href="https://portal.mbktech.org/"><i class="fas fa-globe"></i> Web Portal</a>
                    <a class="btn btn-outline" href="https://portal.mbktech.org/user/settings"><i class="fas fa-user-cog"></i> User Settings</a>
                    <a class="btn btn-outline" href="/mbkauthe/info"><i class="fas fa-info-circle"></i> Info Page</a>
                    <a class="btn btn-outline" href="/mbkauthe/login"><i class="fas fa-sign-in-alt"></i> Login Page</a>
                    {{#if (eq role "superadmin")}}
                    <a class="btn btn-outline" href="/mbkauthe/db"><i class="fas fa-database"></i> Database Logs</a>
                    <a class="btn btn-outline" href="/mbkauthe/validate-superadmin"><i class="fas fa-user-shield"></i> Validate superadmin</a>
                    {{/if}}
                </div>
            </div>
        </div>
    </section>

    {{#if session_expiry}}
    <script>
        (() => {
            const expiry = new Date('{{session_expiry}}');
            const display = document.getElementById('session-expiry-display');
            const countdown = document.getElementById('countdown-value');
            if (display) display.textContent = expiry.toLocaleString();

            function updateCountdown() {
                const diff = expiry - new Date();
                if (!countdown) return;
                if (diff <= 0) {
                    countdown.textContent = 'Expired';
                    countdown.style.color = 'var(--danger)';
                    return;
                }
                const h = Math.floor(diff / 36e5);
                const m = Math.floor((diff % 36e5) / 6e4);
                const s = Math.floor((diff % 6e4) / 1e3);
                countdown.textContent = `${h ? `${h}h ` : ''}${h || m ? `${m}m ` : ''}${s}s`;
                countdown.style.color = diff < 3e5 ? 'var(--warning)' : 'var(--success)';
            }

            updateCountdown();
            setInterval(updateCountdown, 1000);
        })();
    </script>
    {{/if}}
</body>
</html>
