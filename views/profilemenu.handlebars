}

.avatar-img, .mbkauthe-profile-avatar {
    width: 38px;
    height: 38px;
    max-width: 38px;
    max-height: 38px;
    border-radius: 9999px;
    object-fit: cover;
    display: block;
}

.mbkauthe-avatar-fallback {
    width: 100%;
    height: 100%;
    border-radius: 9999px;
    background: #0f766e;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: inherit;
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
}

.mbkauthe-avatar-fallback.small {
    font-size: 0.78rem;
}

.mbkauthe-profile-dropdown {
    position: absolute;
    right: 0;
    top: calc(100% + 0.65rem);
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(15, 118, 110, 0.16);
    border-radius: 14px;
    min-width: 250px;
    max-width: 290px;
    box-shadow: 0 16px 36px -4px rgba(15, 42, 42, 0.12), 0 4px 12px rgba(0, 0, 0, 0.04);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-8px) scale(0.97);
    transform-origin: top right;
    transition: opacity 0.18s cubic-bezier(0.16, 1, 0.3, 1), transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.18s ease;
    z-index: 10000;
    padding: 0.55rem;
}

.mbkauthe-profile-dropdown.open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) scale(1);
}

.mbkauthe-profile-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.75rem;
}

.mbkauthe-profile-header-avatar {
    width: 38px;
    height: 38px;
    border-radius: 9999px;
    border: 1.5px solid rgba(15, 118, 110, 0.25);
    overflow: hidden;
    flex-shrink: 0;
    background: #f0fdfa;
}

.mbkauthe-profile-header-img {
    width: 38px;
    height: 38px;
    max-width: 38px;
    max-height: 38px;
    border-radius: 9999px;
    object-fit: cover;
    display: block;
}

.mbkauthe-profile-header-meta {
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.mbkauthe-profile-signed-in {
    font-size: 0.7rem;
    font-family: inherit;
    color: #667c79;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
    display: flex;
