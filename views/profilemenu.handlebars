    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
}

.mbkauthe-skeleton-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.45rem 0.65rem;
    border-radius: 8px;
    background: #f8fafc;
    border: 1px solid rgba(15, 118, 110, 0.08);
}

.mbkauthe-skeleton-avatar {
    width: 28px;
