    .messageFooter { padding: 1.1rem 1.5rem 1.4rem; display: flex; justify-content: center; }
    .btn-message-action {
        background: var(--primary);
        color: #ffffff;
        border: 1px solid transparent;
        padding: 0.75rem 2rem;
        border-radius: var(--radius);
        font-size: 0.95rem;
        font-family: var(--font-family);
        font-weight: 700;
        cursor: pointer;
        width: 100%;
        box-shadow: 0 4px 12px rgba(15, 118, 110, 0.28);
        transition: var(--transition);
    }
    .btn-message-action:hover {
        background: var(--primary-hover);
        box-shadow: 0 6px 18px rgba(15, 118, 110, 0.4);
        transform: translateY(-1px);
    }

    @media (max-width: 480px) {
        .messageModal { width: 94%; }
        .messageHeader { padding: 1.25rem 1rem 0.5rem; }
        .messageBody { padding: 0.5rem 1.25rem 1rem; }
    }
</style>