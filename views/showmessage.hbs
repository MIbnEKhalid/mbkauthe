<div class="showMessageOverlay" id="messageOverlay" aria-hidden="true" hidden>
    <div class="messageModal" role="dialog" aria-modal="true" aria-labelledby="messageTitle" aria-describedby="messageContent">
        <div class="messageHeader">
            <div class="messageIcon">
                <i class="fas fa-info-circle"></i>
            </div>
            <h2 id="messageTitle">Notification</h2>
        </div>
        <div class="messageBody">
            <p id="messageContent"></p>
            <a href="#" target="_blank" rel="noopener noreferrer" class="errorCodeBadge is-hidden" id="errorCodeLink">
                <i class="fas fa-bug"></i>
                <span id="errorCodeText"></span>
            </a>
        </div>
        <div class="messageFooter">
            <button type="button" class="btn-message-action" onclick="hideMessage()">Okay</button>
        </div>
    </div>
</div>

<script>
    function sanitizeHTML(html) {
        if (!html) return "";
        const doc = new DOMParser().parseFromString(html, "text/html");
        const allowedTags = ["b", "i", "u", "strong", "em", "br", "p", "span", "div", "a", "code"];
        const allowedAttrs = ["href", "target", "class", "id", "style", "rel"];

        function cleanNode(node) {
            Array.from(node.childNodes).forEach((child) => {
                if (child.nodeType === 1) {
                    const tag = child.tagName.toLowerCase();
                    if (allowedTags.includes(tag)) {
                        Array.from(child.attributes).forEach((attr) => {
                            const name = attr.name.toLowerCase();
                            if (!allowedAttrs.includes(name) || name.startsWith("on") || (name === "href" && attr.value.toLowerCase().trim().startsWith("javascript:"))) {
                                child.removeAttribute(attr.name);
                            }
                        });
                        cleanNode(child);
                    } else {
                        child.replaceWith(document.createTextNode(child.textContent));
                    }
                } else if (child.nodeType !== 3) {
                    child.remove();
                }
            });
        }

        cleanNode(doc.body);
        return doc.body.innerHTML;
    }

    function showMessage(message, heading, errorCode) {
        const overlay = document.getElementById("messageOverlay");
        const titleEl = document.getElementById("messageTitle");
        const contentEl = document.getElementById("messageContent");
        const errorLink = document.getElementById("errorCodeLink");
        const errorText = document.getElementById("errorCodeText");
        const iconEl = document.querySelector(".messageIcon i");
        const iconWrap = document.querySelector(".messageIcon");

        if (!overlay || !titleEl || !contentEl) return;

        titleEl.innerText = heading || "Notification";
        contentEl[message?.includes("<") ? "innerHTML" : "innerText"] = message?.includes("<") ? sanitizeHTML(message) : (message || "");

        const lower = (heading || "").toLowerCase();
        if (iconEl && iconWrap) {
            iconEl.className = "fas";
            iconWrap.classList.remove("is-error", "is-success", "is-warning", "is-info");

            if (lower.includes("error") || lower.includes("failed")) {
                iconEl.classList.add("fa-exclamation-circle");
                iconWrap.classList.add("is-error");
            } else if (lower.includes("success")) {
                iconEl.classList.add("fa-check-circle");
                iconWrap.classList.add("is-success");
            } else if (lower.includes("warning")) {
                iconEl.classList.add("fa-exclamation-triangle");
                iconWrap.classList.add("is-warning");
            } else {
                iconEl.classList.add("fa-info-circle");
                iconWrap.classList.add("is-info");
            }
        }

        if (errorLink && errorText) {
            if (errorCode) {
                errorLink.classList.remove("is-hidden");
                errorText.innerText = `Code: ${errorCode}`;
                errorLink.href = `/mbkauthe/ErrorCode/#${errorCode}`;
            } else {
                errorLink.classList.add("is-hidden");
            }
        }

        overlay.removeAttribute("hidden");
        overlay.classList.add("active");
        document.body.classList.add("blur-active");
        overlay.setAttribute("aria-hidden", "false");
        document.querySelector(".btn-message-action")?.focus();
    }

    function hideMessage() {
        const overlay = document.getElementById("messageOverlay");
        if (!overlay) return;
        overlay.classList.add("fade-out");
        setTimeout(() => {
            overlay.classList.remove("active", "fade-out");
            document.body.classList.remove("blur-active");
            overlay.setAttribute("aria-hidden", "true");
            overlay.setAttribute("hidden", "");
        }, 250);
    }

    document.getElementById("messageOverlay")?.addEventListener("click", function(e) {
        if (e.target === this) hideMessage();
    });

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && document.getElementById("messageOverlay")?.classList.contains("active")) {
            hideMessage();
        }
    });

    window.showMessage = showMessage;
    window.hideMessage = hideMessage;
</script>

